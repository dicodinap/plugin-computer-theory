# GraphitoUBB — configuración de despliegue. Copia a .env y edita.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# CRÍTICO: URL exacta con que accederás desde el navegador.
# Debe incluir el mismo host:puerto que escribes en la barra de direcciones.
# Ejemplos:
#   http://192.168.1.50:8080     (IP interna del servidor)
#   http://mi-servidor.local:8080
# Si esto no coincide con lo que abres, el login y el CSS se rompen.
MOODLE_WWWROOT=http://localhost:8080

# Puerto del host donde se publica Moodle (lado izquierdo de "puerto:80").
MOODLE_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Credenciales del admin (primer arranque). CAMBIA la contraseña.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=Admin123#
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_SITE_FULLNAME=GraphitoUBB
MOODLE_SITE_SHORTNAME=graphitoubb

# ---------------------------------------------------------------------------
# Base de datos (CAMBIA la contraseña en un servidor real).
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASS=moodle

# ---------------------------------------------------------------------------
# Idioma del sitio. En el primer arranque descarga el language pack (necesita
# internet); si falla, el sitio queda en inglés.
MOODLE_LANG=es

# ---------------------------------------------------------------------------
# Curso de demostración (demo day): crea "Estructuras Discretas — Demo
# GraphitoUBB" con actividades de todas las herramientas + quiz del banco de
# preguntas + usuarios profesor.demo / estudiante.demo / estudiante2.demo.
# Apágalo (false) para el piloto real, o cambia MOODLE_DEMO_PASS.
MOODLE_SEED_DEMO=true
MOODLE_DEMO_PASS=DemoDay2026#

# ---------------------------------------------------------------------------
# Versiones (normalmente no tocar). MOODLE_405_STABLE = Moodle 4.5 LTS.
MOODLE_PHP_TAG=8.3
MOODLE_BRANCH=MOODLE_405_STABLE
