{{!
    Heatmap tab — colour-coded correctness grid + textual alternative (WCAG).
    AMD hydrates via mod_graphitoubb_get_panel_heatmap WS.

    @template mod_graphitoubb/panel_heatmap
    @package  mod_graphitoubb
    @copyright 2026 GraphitoUBB
    @license   https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<section class="graphitoubb-panel-heatmap py-3" data-region="panel-heatmap-content">

    {{! Loading spinner }}
    <div data-region="heatmap-loading" class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only visually-hidden">{{#str}}panel_loading, mod_graphitoubb{{/str}}</span>
        </div>
    </div>

    {{! No-data message }}
    <p class="text-muted d-none" data-region="heatmap-no-data">
        {{#str}}heatmap_no_data, mod_graphitoubb{{/str}}
    </p>

    {{! ---- Colour legend ---- }}
    <div class="d-none mb-3" data-region="heatmap-legend">
        <span class="fw-semibold me-2">{{#str}}heatmap_legend, mod_graphitoubb{{/str}}:</span>
        <span class="badge me-1" style="background:#c0392b">0–24 %</span>
        <span class="badge me-1" style="background:#e67e22">25–49 %</span>
        <span class="badge me-1" style="background:#f1c40f;color:#000">50–74 %</span>
        <span class="badge me-1" style="background:#7dcea0;color:#000">75–89 %</span>
        <span class="badge me-1" style="background:#27ae60">90–100 %</span>
    </div>

    {{! ---- Visual grid (aria-hidden — textual alternative below is the a11y surface) ---- }}
    <div class="d-none" data-region="heatmap-grid" aria-hidden="true">
        {{! AMD builds:
            <div class="graphitoubb-heatmap-row">
              <div class="graphitoubb-heatmap-cell"
                   data-row="{r}" data-col="{ci}"
                   style="background:{color}"
                   title="{col_label} | fila {r}: {pct}%">
                {pct}%
              </div>
              …
            </div>
            …
        }}
    </div>

    {{! ---- Textual alternative (WCAG 1.1.1 — obligatoria) ---- }}
    <details class="mt-3 d-none" data-region="heatmap-table-details">
        <summary class="fw-semibold mb-1">
            {{#str}}heatmap_textual_alternative, mod_graphitoubb{{/str}}
        </summary>
        <div class="table-responsive">
            <table class="table table-sm table-bordered" data-region="heatmap-table">
                <thead data-region="heatmap-table-head">
                    {{! AMD builds <tr><th>Fila</th><th>Col1</th>…</tr> }}
                </thead>
                <tbody data-region="heatmap-table-body">
                    {{! AMD builds one <tr> per row with <td>pct% (n)</td> per col }}
                </tbody>
            </table>
        </div>
    </details>

    {{! ---- Student list tooltip panel (shown on cell click) ---- }}
    <div class="d-none mt-3" data-region="heatmap-cell-detail">
        <div class="card">
            <div class="card-header fw-semibold" data-region="cell-detail-title"></div>
            <ul class="list-group list-group-flush" data-region="cell-detail-students">
                {{! AMD populates <li> elements with student names }}
            </ul>
        </div>
    </div>

</section>
