{{!
    Editor shell for a graphitoubb attempt.

    Context: {attemptid, instanceid, schemaversion,
              max_states, max_alphabet, max_transitions, max_label_length, max_input_length}

    @template mod_graphitoubb/editor
    @copyright 2026 GraphitoUBB
    @license   https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="mod-graphitoubb-editor"
    data-attemptid="{{attemptid}}"
    data-instanceid="{{instanceid}}"
    data-finished="{{#is_finished}}1{{/is_finished}}{{^is_finished}}0{{/is_finished}}"
    data-max-states="{{max_states}}"
    data-max-alphabet="{{max_alphabet}}"
    data-max-transitions="{{max_transitions}}"
    data-max-label-length="{{max_label_length}}"
    data-max-input-length="{{max_input_length}}">
    {{> mod_graphitoubb/toolbar }}
    <div id="graphitoubb-canvas-{{instanceid}}" class="mod-graphitoubb-canvas">
        <p class="mod-graphitoubb-loading">{{#str}}editor_loading, mod_graphitoubb{{/str}}</p>
        <div class="mod-graphitoubb-zoom-controls" role="group" aria-label="{{#str}}zoom_fit, mod_graphitoubb{{/str}}">
            <button type="button" class="btn btn-sm btn-light mod-graphitoubb-zoom-btn" data-zoom="in"
                    title="{{#str}}zoom_in, mod_graphitoubb{{/str}}" aria-label="{{#str}}zoom_in, mod_graphitoubb{{/str}}">+</button>
            <button type="button" class="btn btn-sm btn-light mod-graphitoubb-zoom-btn" data-zoom="out"
                    title="{{#str}}zoom_out, mod_graphitoubb{{/str}}" aria-label="{{#str}}zoom_out, mod_graphitoubb{{/str}}">−</button>
            <button type="button" class="btn btn-sm btn-light mod-graphitoubb-zoom-btn" data-zoom="fit"
                    title="{{#str}}zoom_fit, mod_graphitoubb{{/str}}" aria-label="{{#str}}zoom_fit, mod_graphitoubb{{/str}}">⤢</button>
            <button type="button" class="btn btn-sm btn-light mod-graphitoubb-zoom-btn" data-zoom="reset"
                    title="{{#str}}zoom_reset, mod_graphitoubb{{/str}}" aria-label="{{#str}}zoom_reset, mod_graphitoubb{{/str}}">100%</button>
        </div>
    </div>
    <ul class="mod-graphitoubb-legend" aria-label="{{#str}}legend_title, mod_graphitoubb{{/str}}">
        <li><span class="mod-graphitoubb-legend-swatch mod-graphitoubb-legend-start"></span>{{#str}}legend_start, mod_graphitoubb{{/str}}</li>
        <li><span class="mod-graphitoubb-legend-swatch mod-graphitoubb-legend-final"></span>{{#str}}legend_final, mod_graphitoubb{{/str}}</li>
        <li><span class="mod-graphitoubb-legend-swatch mod-graphitoubb-legend-visited"></span>{{#str}}legend_visited, mod_graphitoubb{{/str}}</li>
    </ul>
    {{> mod_graphitoubb/simulator_panel }}
    {{> mod_graphitoubb/wordbank_panel }}
    <div class="mod-graphitoubb-submission-bar">
        <span class="mod-graphitoubb-status-label">{{#str}}afd_status_label, mod_graphitoubb{{/str}}</span>
        <span class="mod-graphitoubb-status-badge badge {{#is_finished}}badge-success bg-success{{/is_finished}}{{^is_finished}}badge-warning bg-warning text-dark{{/is_finished}}"
              data-region="attempt-status" aria-live="polite">
            {{#is_finished}}{{#str}}status_finished, mod_graphitoubb{{/str}}{{/is_finished}}{{^is_finished}}{{#str}}status_inprogress, mod_graphitoubb{{/str}}{{/is_finished}}
        </span>
        <button type="button"
                class="btn btn-primary mod-graphitoubb-finish-btn"
                data-region="finish-btn"
                {{#is_finished}}disabled{{/is_finished}}>
            {{#str}}afd_finish_button, mod_graphitoubb{{/str}}
        </button>
    </div>
</div>
{{#js}}
require(['mod_graphitoubb/afd_editor'], function(Editor) {
    Editor.init({{attemptid}}, {{instanceid}}, {{schemaversion}});
});
{{/js}}
