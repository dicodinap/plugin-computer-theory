{{!
    Toolbar panel for the AFD editor.
    Context: {max_states, max_alphabet, max_transitions, max_label_length, max_input_length}
    Bounds are passed as data-attributes so JS reads them without hardcoding.

    @template mod_graphitoubb/toolbar
    @copyright 2026 GraphitoUBB
    @license   https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="mod-graphitoubb-toolbar-buttons"
     role="toolbar"
     aria-label="{{#str}}toolbar_label, mod_graphitoubb{{/str}}"
     data-max-states="{{max_states}}"
     data-max-alphabet="{{max_alphabet}}"
     data-max-transitions="{{max_transitions}}"
     data-max-label-length="{{max_label_length}}"
     data-max-input-length="{{max_input_length}}">
    <button type="button"
            class="btn btn-outline-secondary mod-graphitoubb-tool-btn"
            data-mode="adding_state"
            aria-pressed="false"
            title="{{#str}}mode_hint_adding_state, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-plus-circle" aria-hidden="true"></i>{{#str}}toolbar_add_state, mod_graphitoubb{{/str}}
    </button>
    <button type="button"
            class="btn btn-outline-secondary mod-graphitoubb-tool-btn"
            data-mode="adding_transition_source"
            aria-pressed="false"
            title="{{#str}}mode_hint_adding_transition_source, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-arrow-right" aria-hidden="true"></i>{{#str}}toolbar_add_transition, mod_graphitoubb{{/str}}
    </button>
    <button type="button"
            class="btn btn-outline-secondary mod-graphitoubb-tool-btn"
            data-mode="setting_start"
            aria-pressed="false"
            title="{{#str}}mode_hint_setting_start, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-play" aria-hidden="true"></i>{{#str}}toolbar_set_start, mod_graphitoubb{{/str}}
    </button>
    <button type="button"
            class="btn btn-outline-secondary mod-graphitoubb-tool-btn"
            data-mode="toggling_final"
            aria-pressed="false"
            title="{{#str}}mode_hint_toggling_final, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-bullseye" aria-hidden="true"></i>{{#str}}toolbar_toggle_final, mod_graphitoubb{{/str}}
    </button>
    <button type="button"
            class="btn btn-outline-secondary mod-graphitoubb-tidy-btn"
            data-action="tidy"
            title="{{#str}}tidy_tooltip, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-sitemap" aria-hidden="true"></i>{{#str}}tidy_button, mod_graphitoubb{{/str}}
    </button>
    <button type="button"
            class="btn btn-outline-danger mod-graphitoubb-tool-btn"
            data-mode="deleting"
            aria-pressed="false"
            title="{{#str}}mode_hint_deleting, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-trash" aria-hidden="true"></i>{{#str}}toolbar_delete, mod_graphitoubb{{/str}}
    </button>
    <button type="button"
            class="btn btn-outline-danger mod-graphitoubb-reset-automaton-btn"
            data-action="reset-automaton"
            title="{{#str}}tooltip_reset, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-eraser" aria-hidden="true"></i>{{#str}}reset_automaton_button, mod_graphitoubb{{/str}}
    </button>
    <button type="button"
            class="btn btn-outline-secondary mod-graphitoubb-history-btn mod-graphitoubb-undo-btn"
            data-action="undo" disabled
            aria-label="{{#str}}undo_tooltip, mod_graphitoubb{{/str}}"
            title="{{#str}}undo_tooltip, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-undo" aria-hidden="true"></i>{{#str}}undo_button, mod_graphitoubb{{/str}}
    </button>
    <button type="button"
            class="btn btn-outline-secondary mod-graphitoubb-history-btn mod-graphitoubb-redo-btn"
            data-action="redo" disabled
            aria-label="{{#str}}redo_tooltip, mod_graphitoubb{{/str}}"
            title="{{#str}}redo_tooltip, mod_graphitoubb{{/str}}">
        <i class="icon fa fa-redo" aria-hidden="true"></i>{{#str}}redo_button, mod_graphitoubb{{/str}}
    </button>
    <span class="mod-graphitoubb-save-indicator" aria-live="polite"></span>
</div>
<p class="mod-graphitoubb-mode-hint" aria-live="polite">{{#str}}mode_hint_idle, mod_graphitoubb{{/str}}</p>
<div class="mod-graphitoubb-alphabet-panel" data-max-alphabet="{{max_alphabet}}">
    <span class="mod-graphitoubb-alphabet-label">{{#str}}alphabet_label, mod_graphitoubb{{/str}}</span>
    <div class="mod-graphitoubb-alphabet-input-group">
        <input type="text"
               class="mod-graphitoubb-alphabet-input form-control form-control-sm"
               maxlength="1"
               aria-label="{{#str}}alphabet_input_aria, mod_graphitoubb{{/str}}" />
        <button type="button" class="btn btn-sm btn-outline-secondary mod-graphitoubb-alphabet-add">
            {{#str}}alphabet_add, mod_graphitoubb{{/str}}
        </button>
    </div>
    <ul class="mod-graphitoubb-alphabet-list"></ul>
</div>
