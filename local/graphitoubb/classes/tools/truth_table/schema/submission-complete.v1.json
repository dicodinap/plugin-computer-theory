{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "local_graphitoubb/truth_table/submission-complete.v1",
  "title": "Truth Table — Complete Submission (v1)",
  "description": "Schema for a student submission to a truth_table problem of type 'complete'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "schema_version", "type", "table", "radio_answer"],
  "properties": {
    "tool": {
      "type": "string",
      "const": "truth_table"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "complete"
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vars", "values"],
            "properties": {
              "vars": {
                "type": "object",
                "description": "Variable assignment for this row. Keys are uppercase letters A–Z; values are 'V' or 'F'.",
                "additionalProperties": {
                  "type": "string",
                  "enum": ["V", "F"]
                }
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["V", "F", ""]
                }
              }
            }
          }
        }
      }
    },
    "radio_answer": {
      "type": "null",
      "description": "Always null for 'complete' type — there is no radio answer."
    }
  }
}
